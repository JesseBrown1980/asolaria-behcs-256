  "created": "2026-04-17",
  "week_override": "COSIGN-MERGED-034",
  "description": "Machine-readable registry of BEHCS-256 glyph families. Section R.3 deliverable. 14 families declared; profile family carries 4 seeds + 12 PROF-HERMES-* Phase-1+2 atoms (2026-04-18 batch-cosign).2 Acer Class corpus extraction. Every unresolved glyph reference parses to `unknown_glyph` violation.",
  "operators": {
    "concat": {
      "symbol": "·",
      "precedence": 5,
      "phonetic_class": "vowel"
    },
    "nest": {
      "symbol": "{ }",
      "precedence": 3,
      "phonetic_class": "vowel"
    },
    "modify": {
      "symbol": "@",
      "precedence": 1,
      "phonetic_class": "vowel"
    },
    "lift": {
      "symbol": "^",
      "precedence": 2,
      "phonetic_class": "vowel"
    },
    "pipe": {
      "symbol": "|>",
      "precedence": 4,
      "phonetic_class": "vowel"
    },
    "mood_tone": {
      "symbol": "@M-*",
      "precedence": 6,
      "phonetic_class": "tone",
      "role": "sentence-terminal mood modifier"
    }
  },
  "blast_radii": [
    "device",
    "instance",
    "operation",
    "colony"
  ],
  "moods": {
    "M-INDICATIVE": {
      "d11": "PROVEN",
      "semantics": "deductive closure"
    },
    "M-EYEWITNESS": {
      "d11": "OBSERVED",
      "semantics": "first-person observation with on-disk evidence"
    },
    "M-SUBJUNCTIVE": {
      "d11": "ASSUMED",
      "semantics": "default; conjecture / draft"
    }
  },
  "families": {
    "dimension": {
      "prefix": "D",
      "default_blast": "colony",
      "phonetic_class": "consonant",
      "role": "cube-axis identifiers",
      "examples": [
        "D11",
        "D15",
        "D24"
      ],
      "notes": "D11=proof, D15=authority, D24=intent. Full axis census pending."
    },
    "proof": {
      "prefix": "PROOF",
      "default_blast": "colony",
      "phonetic_class": "consonant",
      "role": "evidence stamp tags",
      "examples": [
        "PROOF-PROVEN",
        "PROOF-OBSERVED",
        "PROOF-INHERITED",
        "PROOF-ASSUMED"
      ],
